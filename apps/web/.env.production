# Production build-time environment variables
# This file is committed to the repo so Next.js always has these values at build time.
# NEXT_PUBLIC_* vars are inlined into the JS bundle during `next build`.

# API calls are same-origin and reverse-proxied by Next (see next.config.ts rewrites)
# to the backend, avoiding browser mixed-content now that the web is served over HTTPS.
# Leave empty so the frontend uses relative /api/* paths (same https origin).
NEXT_PUBLIC_API_URL=
